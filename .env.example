# WisDev open-source local defaults.
# Put real secret values in your shell or a local .env file that is not committed.

WISDEV_CONFIG=config/wisdev.example.yaml
SCHOLAR_MODELS_CONFIG=../scholar_models.json
WISDEV_STATE_DIR=.wisdev/state
WISDEV_JOURNAL_PATH=.wisdev/wisdev_journal.jsonl
WISDEV_ORCHESTRATOR_URL=http://127.0.0.1:8081
# When 1, prefer manifest ports when free and otherwise pick ephemeral ports.
# `wisdev stack ports --write` saves the allocation to .wisdev/ports.env.
WISDEV_AUTO_PORT=1
WISDEV_MODE=yolo
WISDEV_RESEARCH_TOKEN_BUDGET=400000  # per-request research token budget enforced by the unified research runtime; unset/0 still enforces the 400000 default (never unlimited)
WISDEV_LLM_API_KEY=
# Local inference: ollama | openai-compatible | vertex (default: use BASE_URL when set)
WISDEV_LLM_PROVIDER=ollama
WISDEV_LLM_BASE_URL=http://127.0.0.1:11434/v1
WISDEV_LLM_MODEL=llama3.1
WISDEV_LLM_MODEL_LIGHT=llama3.2:1b
WISDEV_LLM_MODEL_STANDARD=llama3.1
WISDEV_LLM_MODEL_HEAVY=qwen2.5:7b
# Manuscript drafting (DocGen) provider selector, independent of WISDEV_LLM_*:
# gemini | vertex | cloud (recommended for fullpaper — uses Vertex credentials below)
# local | ollama -> local OpenAI-compatible server; unset auto-picks local when configured.
MANUSCRIPT_LLM_PROVIDER=gemini
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=llama3.1
LOCAL_LLM_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GOOGLE_API_KEY_SECRET_NAME=
GEMINI_API_KEY_SECRET_NAME=
RAG_FILE_SEARCH_STORE_NAMES=
RAG_FILE_SEARCH_METADATA_FILTER=
RAG_FILE_SEARCH_TOP_K=8
RAG_FILE_SEARCH_MODEL=
RAG_FILE_SEARCH_MULTIMODAL=true
RAG_FILE_SEARCH_REQUIRED=false
RAG_FILE_SEARCH_EMBEDDING_MODEL=
PYTHON_SIDECAR_HTTP_URL=http://127.0.0.1:8090
PYTHON_SIDECAR_GRPC_ADDR=127.0.0.1:50052
TEMPORAL_ENABLED=false
# When 1, prefer manifest ports when free and otherwise pick ephemeral ports.
# `wisdev stack ports --write` saves the allocation to .wisdev/ports.env (auto-loaded).
WISDEV_AUTO_PORT=1
